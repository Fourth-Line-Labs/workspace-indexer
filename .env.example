# ---- dense embeddings (provider:model, resolved by pydantic-ai) ----
EMBEDDING_MODEL=voyageai:voyage-code-4
EMBEDDING_DIMENSIONS=2048
EMBEDDING_QUANTIZATION=float32
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_MAX_BATCH_TOKENS=100000

# What a million input tokens costs. Used only when the provider reports no
# price of its own -- genai-prices has no entry for voyage-code-4, so without
# this every run records $0.0000, which reads as free rather than as unknown.
# A number here goes stale silently, so a cost derived from it is displayed as
# an estimate (~$0.1234) rather than as a fact.
EMBEDDING_PRICE_PER_MTOK=0.12

# Size of the provider's free allowance, if it has one. `status` reports how
# much of it this manifest has drawn down. Approximate by construction: the
# allowance belongs to the account and is spent by everything using the key.
EMBEDDING_FREE_TIER_TOKENS=200000000
VOYAGE_API_KEY=

# ---- sparse (local, free) ----
SPARSE_MODEL=Qdrant/bm25

# ---- reranking ----
# Both override the `search.rerank` block in workspace.yaml, and only when set.
RERANK_ENABLED=true
# provider:model. The provider says *where* the model runs:
#   voyageai:  a call from this process, after retrieval
#   local:     a cross-encoder in this process
# `database:` (reranking inside the store's own query) was retired -- no
# environment this project can reach supports Atlas $rerank, so it is refused
# at config load. See issue #73; issue #94 restores it if that ever changes.
RERANK_MODEL=voyageai:rerank-2.5-lite

# ---- vector store ----
# qdrant | mongodb. The Qdrant keys below are read only for the former, the
# MONGODB_ ones only for the latter.
VECTOR_STORE=qdrant
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ON_DISK_PAYLOAD=true

# ---- mongodb atlas (only when VECTOR_STORE=mongodb) ----
# From Atlas: Connect > Drivers. Carries the password inline, which is why it
# lives here and never in workspace.yaml. Needs `poetry install --extras mongo`.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=workspace_indexer
# float32 | int8. float32 is binData at 4 bytes per dimension -- 2.4x smaller
# than an array of doubles. int8 is 4x smaller again and costs some recall;
# reach for it only when a Free cluster's 512 MB is the binding constraint.
MONGODB_VECTOR_DTYPE=float32

# ---- state ----
STATE_DB=./data/manifest.sqlite3

# ---- logging ----
LOG_LEVEL=INFO
LOGFIRE_ENABLED=false
LOGFIRE_SEND_TO_CLOUD=false
LOGFIRE_TOKEN=
